# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# GEMINI_API_KEY="your_gemini_api_key_here"

# AI providers (backend only — never prefix with VITE_; the browser never sees them).
# AI_PROVIDER picks "claude" (default) or "groq" for the lead pipeline.
# AI_PROVIDER="claude"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"
# GROQ_MODEL="llama-3.3-70b-versatile"
SERPER_API_KEY="your_serper_api_key_here"

# Outreach email (backend only). No defaults: without SMTP_USER and
# SMTP_PASSWORD the email routes answer 503 "SMTP not configured".
# For Gmail, SMTP_PASSWORD is an app password, not the account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_smtp_username_here"
SMTP_PASSWORD="your_smtp_app_password_here"
# SMTP_FROM defaults to SMTP_USER.
# SMTP_FROM="sales@example.com"
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Leave empty in local development (Vite proxies /api to localhost:8000) and
# in production (FastAPI serves the frontend and API from the same origin).
VITE_API_URL=""


# PostgreSQL database for the backend. Create the local Lead_DB before starting it.
DATABASE_URL="postgres://USER:PASSWORD@localhost:5432/Lead_DB"

# Staff Portal activity log AND access checks (backend only — do not prefix
# with VITE_). Get this app's key from the portal at /dashboard/api-keys.
# Without these, every API route refuses access.
STAFF_PORTAL_URL="http://localhost:3000"
ACTIVITY_LOG_API_KEY="bbp_your_key_here"

# Staff Portal sign-in (backend only). JWT_SECRET must equal the portal's
# JWT_SECRET; SESSION_SECRET is this app's own and must differ from it.
# Handoff tokens must carry iss "bb-staff-portal" and aud "lead-gen-agent".
JWT_SECRET=replace-with-the-portal-handoff-secret
SESSION_SECRET=replace-with-at-least-32-random-characters
# Cookie flags. Secure is on automatically when STAFF_PORTAL_URL is https://.
# Portal and agent on different sites: SESSION_COOKIE_SAMESITE=none (forces Secure).
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=lax

# --- Lead Matchmaker module (backend only) --------------------------------------
# Website enquiries: the website's server POSTs to /api/public/enquiry with the
# header X-LeadMatch-Key. Set the SAME value as the website's LEADMATCH_KEY, and
# point the website's LEADMATCH_API_URL (and LEADMATCH_APP_URL) at this app.
# Without it, website enquiries are refused (503); manual entry still works.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MATCHMAKER_ENQUIRY_SECRET="replace-with-at-least-32-random-characters"
# Optional. Country assumed when an enquiry or upload doesn't say, and the
# country code added to local phone numbers for WhatsApp links.
# MATCHMAKER_DEFAULT_COUNTRY="United Arab Emirates"
# MATCHMAKER_DEFAULT_COUNTRY_CODE="971"
# Optional. How drafts are signed (defaults: V.V. & Sons).
# MATCHMAKER_SENDER_COMPANY="V.V. & Sons LLC"
# MATCHMAKER_SENDER_SHORT_NAME="V.V. & Sons"
# MATCHMAKER_SENDER_PHONE="+971 52 819 4988"
# MATCHMAKER_SENDER_EMAIL="cpd@vvsons.ae"
# MATCHMAKER_SENDER_WEBSITE="vvsgrocer.com"
# Optional. Company research and "Personalise with AI" use AI_PROVIDER above;
# Claude model for them (default claude-opus-5-5). Website lookups use SERPER_API_KEY.
# MATCHMAKER_CLAUDE_MODEL="claude-opus-5-5"
# MATCHMAKER_CONCURRENCY="3"
